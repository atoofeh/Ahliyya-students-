# dependencies
node_modules/

# environment — real secrets never enter history
.env
.env.*
!.env.example
# non-secret build configuration for the Android package (an API URL, nothing else)
!client/.env.android

# runtime data — encrypted media, temp chunks, logs (1.6 GB+, never commit)
server/storage/
server/logs/
*.log

# build output
client/dist/
client/android/app/build/
client/android/build/
client/android/.gradle/
client/android/local.properties
client/android/app/release/
client/android/capacitor-cordova-android-plugins/build/
*.keystore
*.jks
client/android/keystore.properties

# editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# built app packages
*.apk

# Firebase.
# client/android/app/google-services.json IS committed: it ships inside every
# APK by design, Google scopes that key to this package and signing key, and a
# missing copy makes the Gradle build silently skip the push plugin — the app
# then builds fine and simply never receives anything.
# The admin SDK key is the opposite: a private key that can send as this
# project. It lives only in server/.env and must never enter git or an APK.
*-firebase-adminsdk-*.json
firebase-adminsdk*.json
/google-services.json
